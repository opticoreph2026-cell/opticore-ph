# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Pooled connection for app runtime (Supabase → Settings → Database → Connection string → URI + ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Authentication (NextAuth v5) ─────────────────────────────────────────────
# Run `openssl rand -base64 32` to generate
AUTH_SECRET="dev-secret-key-change-in-prod-minimum-32-chars!"
AUTH_URL="http://localhost:3000"

# Legacy JWT vars — deprecated, remove after migration
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# ── Email (Resend — magic link + transactional) ──────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="OptiCore Energy <noreply@opticore.ph>"

# ── AI / Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Payments (PayMongo) ─────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY="sk_test_..."
PAYMONGO_PUBLIC_KEY="pk_test_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# ── Email (Gmail OAuth2 — legacy fallback) ───────────────────────────────────
GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REFRESH_TOKEN="1//your-refresh-token"
GMAIL_USER="your-email@gmail.com"

# ── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Cloudflare Turnstile (optional) ─────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
