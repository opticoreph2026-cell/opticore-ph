# ── Database ────────────────────────────────────────────────────────────────
# Local dev uses SQLite. Production uses LibSQL/Turso.
DATABASE_URL="file:./dev.db"

# Turso (Production only - db.js will use these if present)
# TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# ── Authentication ──────────────────────────────────────────────────────────
# Run `openssl rand -base64 32` to generate these
JWT_SECRET="dev-secret-key-change-in-prod-minimum-32-chars!"
JWT_REFRESH_SECRET="dev-refresh-secret-key-change-in-prod-32-chars!"

# ── AI / Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Payments (PayMongo) ─────────────────────────────────────────────────────
PAYMONGO_SECRET_KEY="sk_test_..."
PAYMONGO_PUBLIC_KEY="pk_test_..."
PAYMONGO_WEBHOOK_SECRET="whsec_..."

# ── Email (Gmail OAuth2) ────────────────────────────────────────────────────
# Follow instructions in src/lib/email.js to get these
GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REFRESH_TOKEN="1//your-refresh-token"
GMAIL_USER="your-email@gmail.com"

# ── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
